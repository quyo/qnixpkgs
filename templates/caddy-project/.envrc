while IFS= read -r -d $'\0' file; do watch_file "$file"; done < <(find . -name "*.nix" -type f -print0)
watch_file flake-devshell.toml
watch_file flake-packages-devenv.json
watch_file flake-packages-runtime.json
use flake .#flake-devshell

dotenv

source_env .envrc.aliases
watch_file .envrc.aliases
